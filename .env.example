# Firebase Authentication & Cloud Firestore Configuration
# Get these keys from Firebase Console -> Project Settings -> General -> Web App

VITE_FIREBASE_API_KEY=AIzaSyYourActualFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Google Sheets Feedback Webhook URL (Google Apps Script Web App)
# Deploy Apps Script with Who has access = Anyone, and paste the /exec URL below
VITE_GOOGLE_SHEETS_FEEDBACK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
